class Solution {
public:
    int getSum(int n) { //here i am making function for finding sum of squares of digits
        int sum = 0;

        while (n > 0) {
            int digit = n % 10;
            sum += digit * digit;
            n /= 10;
        }

        return sum;
    }

    bool isHappy(int n) {
        int slow = n;  //using slow and fast pointer bcz we check if ye cycle mein h ki nahi, agar h toh false nahi haan toh true 
        int fast = n;

        do {
            slow = getSum(slow);
            fast = getSum(getSum(fast));
        } while (slow != fast);

        return slow == 1;
    }
};
