class Solution {
public:
    int findNumbers(vector<int>& nums) {
        int count = 0;

        for(int i = 0; i < nums.size(); i++) {
            int num = nums[i];   // current element hain 

            int digits = 0;
            int temp = num;  //using temp because we don't want to destroy the original value of num.

            while(temp > 0) {
                digits++;
                temp /= 10;
            }

            if(digits % 2 == 0) {
                count++;
            }
        }
        return count;
    }
};
